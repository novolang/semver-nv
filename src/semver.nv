// semver.nv — semantic versions, the order they are compared in, and
// the requirements a manifest writes against them.
//
// A version is MAJOR.MINOR.PATCH, three non-negative integers, with an
// optional prerelease label after a hyphen and optional build metadata
// after a plus.  Semantic Versioning 2.0.0 item 2 gives that form.  A
// requirement is what a manifest writes where a version would go.  It
// is one of `^1.2`, `~0.4.1`, `>=1.0.0`, `=1.4.2`, `1.x` or `*`, or
// several of those separated by commas.  The two together answer the
// question a package manager asks.  A program names a requirement, a
// registry lists the versions that exist, and one of them is installed.
//
// `parse` reads a version.  `compare` orders two of them.  `matches`
// and `satisfies` answer yes or no about one version.  `best` picks
// the version to install out of the ones a registry lists.  Each
// carries a worked example above its declaration.
//
// The requirement grammar is the Orbit registry's rather than the
// specification's.  Semantic Versioning 2.0.0 defines versions and
// their precedence and says nothing about `^` or `~`.
//
// Parsing is one pass over the text and `best` is one pass over the
// candidates.  There is no table and no state, and the only allocation
// is the pieces the splitting produces.  No function here reads or
// writes anything.
//
// Two answers differ from what a reader of the specification expects.
// Both are stated where they are visible rather than left to be found.
//
//   * Prerelease labels are compared as plain text.  Item 11 compares
//     them as dot-separated identifiers and a numeric identifier as a
//     number.  Plain text orders `alpha` before `beta` before `rc`,
//     which is the common case, and puts `rc.10` before `rc.2`.  The
//     Orbit registry compares them as plain text as well.
//   * A leading zero is accepted.  Item 2 refuses one, and so does the
//     Orbit registry, which lists `01.2.3` among the strings its
//     MALFORMED_VERSION rule rejects.  Here `parse("01.2.3")` answers
//     the version `1.2.3`.  A version this parser accepts can still be
//     refused at publish.
//
// Build metadata is parsed, kept so that `text` can write it back out,
// and ignored in every comparison.  Item 10 requires that, so two
// versions differing only in build metadata are one version.

use std.list
use std.str

// A parsed semantic version.  Three numbers, and the two optional
// labels that may follow them.
//
// `pre` is the prerelease label and `build` is the build metadata,
// each without the character that introduces it.  Both are the empty
// string when the version carried neither, so there is no optional to
// unwrap for the common case.  A reader asks `is_prerelease()` rather
// than matching on a `?Str`.  `parse` answers a value of this type and
// `text` writes one back out.
//
// ```novo
// let v = semver.parse("1.4.2-rc.1+build.7")!
// println("${v.major} ${v.minor} ${v.patch} ${v.pre} ${v.build}")
// // 1 4 2 rc.1 build.7
// ```
pub struct Version
    major: Int
    minor: Int
    patch: Int
    pre: Str
    build: Str

// Read `text` as a version, or answer `None` when it is not one.
//
// All three numbers are required and nothing else is accepted.  `1.2`,
// `1.2.3.4`, `v1.2.3`, `1.2.x` and a bare trailing hyphen are each
// `None`.  The trailing hyphen is refused because Semantic Versioning
// 2.0.0 item 9 requires a prerelease identifier to be non-empty.  A
// partial form such as `1.2` is a requirement rather than a version,
// and `matches` is what reads one.
//
// A leading zero is accepted, so `01.2.3` answers the version `1.2.3`.
// Item 2 refuses a leading zero, and the Orbit registry refuses it at
// publish time, so a caller checking a version before publishing it
// needs that check of its own.
//
// ```novo
// match semver.parse("1.4.2-rc.1+build.7")
//     None    => println("not a version")
//     Some(v) => println("${v.major}.${v.minor}.${v.patch} ${v.pre} ${v.build}")
// // 1.4.2 rc.1 build.7
//
// // A version needs all three numbers, and no `v` in front of them.
// println("${semver.parse("1.2") == None} ${semver.parse("v1.2.3") == None}")
// // true true
// ```
pub fn parse(text: Str) -> ?Version
    // Build metadata comes off first.  It takes no part in ordering,
    // so nothing below has to step around it.
    var core = text
    var build = ""
    match str.index(text, "+")
        None    =>
            build = ""
        Some(i) =>
            build = str.slice(text, i + 1, str.len(text))
            core = str.slice(text, 0, i)
    var pre = ""
    match str.index(core, "-")
        None    =>
            pre = ""
        Some(i) =>
            pre = str.slice(core, i + 1, str.len(core))
            core = str.slice(core, 0, i)
    let parts = str.split(core, ".")
    if list.len(parts) != 3
        None
    else if not (all_digits(parts[0]) and all_digits(parts[1]) and all_digits(parts[2]))
        None
    else if str.len(pre) == 0 and str.contains(text, "-")
        // `1.2.3` followed by a hyphen and nothing else.  That is a
        // prerelease label the author left empty, not an absent one.
        None
    else
        Some(Version { major: str.to_int(parts[0]) ?? 0,
                       minor: str.to_int(parts[1]) ?? 0,
                       patch: str.to_int(parts[2]) ?? 0,
                       pre: pre, build: build })

// Answer -1, 0 or 1 for the order of two versions.
//
// The order is precedence, which Semantic Versioning 2.0.0 item 11
// defines, and it is not the order of the two strings.  `0.10.0` is
// above `0.9.0` as a version and below it alphabetically.  A resolver
// that sorted the text would install the wrong release.
//
// A release outranks a prerelease carrying the same three numbers, so
// `1.0.0-alpha` is below `1.0.0`.  That is item 11 as well.  Build
// metadata takes no part, per item 10, so two versions differing only
// in it answer 0.  An answer of 0 therefore does not mean the two
// strings are the same.
//
// Prerelease labels are compared as plain text rather than as the
// dot-separated identifiers item 11 describes, so `rc.10` is below
// `rc.2`.
//
// ```novo
// // Version order, not text order: "0.9.0" is above "0.10.0"
// // alphabetically and below it as a version.
// println("${semver.compare(semver.parse("0.9.0")!, semver.parse("0.10.0")!)}")
// // -1
//
// // A release outranks its own prerelease.
// println("${semver.compare(semver.parse("1.0.0-rc.1")!, semver.parse("1.0.0")!)}")
// // -1
//
// // Build metadata is not part of the version.
// println("${semver.compare(semver.parse("1.0.0")!, semver.parse("1.0.0+2026")!)}")
// // 0
// ```
pub fn compare(a: Version, b: Version) -> Int
    if a.major != b.major
        rank(a.major < b.major)
    else if a.minor != b.minor
        rank(a.minor < b.minor)
    else if a.patch != b.patch
        rank(a.patch < b.patch)
    else if a.pre == b.pre
        0
    else if str.len(a.pre) == 0
        1
    else if str.len(b.pre) == 0
        -1
    else
        rank(a.pre < b.pre)

// The questions a version answers about itself.
impl Version
    // Answer the version as text, in the form it parses from.
    //
    // `parse(v.text())` answers `v` again for every version this type
    // can hold, which is the direction a round-trip test asserts.  The
    // other direction holds for every string `parse` accepts but one.
    // A leading zero is accepted and never written back, so
    // `parse("01.2.3")!.text()` is `1.2.3`.
    //
    // ```novo
    // println(semver.parse("1.4.2-rc.1+build.7")!.text())
    // // 1.4.2-rc.1+build.7
    // ```
    fn text(self) -> Str
        var out = "${self.major}.${self.minor}.${self.patch}"
        if str.len(self.pre) > 0
            out = out + "-" + self.pre
        if str.len(self.build) > 0
            out = out + "+" + self.build
        out

    // Answer whether this version carries a prerelease label.
    //
    // A prerelease ranks below the plain version with the same three
    // numbers, which is Semantic Versioning 2.0.0 item 9.  It is also
    // the question that decides whether a resolver may choose the
    // version at all.  A prerelease is chosen only where the
    // requirement named one at the same three numbers.  Build metadata
    // is not a prerelease, so `1.0.0+2026` is a release.
    //
    // ```novo
    // println("${semver.parse("1.0.0-rc.1")!.is_prerelease()}")   // true
    // println("${semver.parse("1.0.0+2026")!.is_prerelease()}")   // false
    // ```
    fn is_prerelease(self) -> Bool
        str.len(self.pre) > 0

// ── Requirements ─────────────────────────────────────────────────────

// One primitive of a requirement.  A requirement is a conjunction of
// these, so a version answers it only by answering every one.
enum Bound
    // `*`, which every release answers.
    Any
    // `1.x`, which any version with this major answers.
    AnyMinor(major: Int)
    // `1.2.x`, which any version with this major and minor answers.
    AnyPatch(major: Int, minor: Int)
    // `^1.2`, at least this version and below the next one allowed to
    // break a caller.  `written` is how many of the three numbers the
    // author gave.
    Caret(base: Version, written: Int)
    // `~1.2`, at least this version and below the next minor.  Below
    // the next major where only the major was written.
    Tilde(base: Version, written: Int)
    // `>=1.0.0` and its siblings, a bare `=` included.
    Compare(op: Str, base: Version)

// Answer whether `version` satisfies `requirement`.
//
// A requirement that does not parse answers `false`.  The two outcomes
// are not told apart here, and `requirement_ok` is how a caller
// separates "nothing answers it" from "that is not a requirement".
//
// A requirement is a conjunction separated by commas, so a version
// answers it only by answering every part.  Two rules decide most of
// the `false` answers a caller will read.  A caret moves its promise
// down one place below `1.0.0`, so `^0.4.1` refuses `0.5.0`.  A
// prerelease is never picked up by accident, so `^1.0.0` refuses
// `1.1.0-alpha` and so does `*`.
//
// ```novo
// // Caret allows anything that is not allowed to break you.
// println("${semver.matches("^1.2", semver.parse("1.9.0")!)}")   // true
// println("${semver.matches("^1.2", semver.parse("2.0.0")!)}")   // false
//
// // Below 1.0.0 the minor is the break, which is what `0.x` means.
// println("${semver.matches("^0.4.1", semver.parse("0.4.9")!)}")   // true
// println("${semver.matches("^0.4.1", semver.parse("0.5.0")!)}")   // false
//
// // A prerelease arrives only where one was asked for.
// println("${semver.matches("^1.0.0", semver.parse("1.1.0-alpha")!)}")     // false
// println("${semver.matches("^1.1.0-alpha", semver.parse("1.1.0-beta")!)}") // true
// ```
pub fn matches(requirement: Str, version: Version) -> Bool
    match parse_requirement(requirement)
        None         => false
        Some(bounds) => satisfies_all(version, bounds)

// Answer whether the version written as `version_text` satisfies
// `requirement`.
//
// This is the form for a caller holding both as text, which is what a
// manifest and a registry listing each hold.  A `version_text` that is
// not a version answers `false`, as a requirement that is not a
// requirement does.  The call asks one yes-or-no question and never
// says which side was malformed.  `parse` and `requirement_ok` are
// what answer that.
//
// ```novo
// println("${semver.satisfies(">=1.0.0, <2.0.0", "1.4.2")}")   // true
// println("${semver.satisfies(">=1.0.0, <2.0.0", "2.0.0")}")   // false
//
// // A conjunction: every part has to hold.
// println("${semver.satisfies("^1.2, <1.5", "1.9.0")}")   // false
//
// // Text that is not a version answers no, rather than complaining.
// println("${semver.satisfies("*", "v1.2.3")}")   // false
// ```
pub fn satisfies(requirement: Str, version_text: Str) -> Bool
    match parse(version_text)
        None    => false
        Some(v) => matches(requirement, v)

// Answer whether `requirement` is a requirement at all.
//
// This is the question `matches` and `best` cannot answer.  Both say
// no to a requirement nothing satisfies and no to a string that is not
// a requirement.  A manifest reader has to tell those apart, because
// one is a resolution failure and the other is a typo to report.  Ask
// this once, where the manifest is read.
//
// ```novo
// println("${semver.requirement_ok("^1.2")} ${semver.requirement_ok(">=1.0, <2")}")
// // true true
//
// // A wildcard under an operator names no version to compare against.
// println("${semver.requirement_ok(">=1.x")}")   // false
//
// // `best` says None to both of these.  Only this says which is which.
// println("${semver.requirement_ok("not a requirement")}")   // false
// ```
pub fn requirement_ok(requirement: Str) -> Bool
    match parse_requirement(requirement)
        None    => false
        Some(_) => true

// Answer the highest of `candidates` that satisfies `requirement`, or
// `None`.
//
// This is the question a resolver asks.  The candidates are the
// versions a registry lists and the answer is the one to install.  The
// text that comes back is the candidate as it was written rather than
// a re-rendering, so a caller can hand it straight back to the
// registry.
//
// A candidate that does not parse is skipped rather than refused,
// because it is not a release the registry could serve.  One bad entry
// in a listing does not stop a resolve.  `None` covers both "nothing
// here answers it" and "that is not a requirement", and
// `requirement_ok` tells those apart.
//
// ```novo
// // Highest wins, and version order is not text order: 0.4.10 is
// // above 0.4.2, and 0.5.0 is outside a caret on 0.4.
// println(semver.best("^0.4", ["0.4.1", "0.4.10", "0.4.2", "0.5.0"]) ?? "none")
// // 0.4.10
//
// // Nothing in range answers with nothing.
// println(semver.best("^2", ["0.4.1", "1.0.0"]) ?? "none")   // none
//
// // A prerelease is not chosen unless the requirement named one.
// println(semver.best("^1.0.0", ["1.1.0-alpha", "1.0.0"]) ?? "none")   // 1.0.0
// ```
pub fn best(requirement: Str, candidates: [Str]) -> ?Str
    match parse_requirement(requirement)
        None         => None
        Some(bounds) =>
            var chosen: ?Str = None
            var chosen_v = zero_version()
            for text in candidates
                // A candidate that does not parse is not a release the
                // registry could serve, so it is not a candidate.
                let candidate = parse(text)
                let wins = match candidate
                    None    => false
                    Some(v) => satisfies_all(v, bounds) and better(v, chosen, chosen_v)
                if wins
                    chosen = Some(text)
                    chosen_v = candidate ?? chosen_v
            chosen

// ── Parsing a requirement ────────────────────────────────────────────

// `requirement` as its primitives, or `None` when any of them is not
// one.  A requirement is a conjunction, so one bad primitive makes the
// whole string unusable rather than partly usable.
fn parse_requirement(requirement: Str) -> ?[Bound]
    let pieces = str.split(requirement, ",")
    var bounds: [Bound] = []
    var ok = list.len(pieces) > 0
    for piece in pieces
        match parse_bound(str.trim(piece))
            None    =>
                ok = false
            Some(b) =>
                bounds = list.push(bounds, b)
    if ok
        Some(bounds)
    else
        None

// One primitive.  A bare version is a caret requirement, which is the
// convention every manifest format that writes `"1.2"` follows.
fn parse_bound(piece: Str) -> ?Bound
    if str.len(piece) == 0
        None
    else if piece == "*"
        Some(Any)
    else if str.starts_with(piece, "^")
        with_version(piece, 1, "^")
    else if str.starts_with(piece, "~")
        with_version(piece, 1, "~")
    else if str.starts_with(piece, ">=")
        with_version(piece, 2, ">=")
    else if str.starts_with(piece, "<=")
        with_version(piece, 2, "<=")
    else if str.starts_with(piece, ">")
        with_version(piece, 1, ">")
    else if str.starts_with(piece, "<")
        with_version(piece, 1, "<")
    else if str.starts_with(piece, "=")
        with_version(piece, 1, "=")
    else
        bare_bound(piece)

// The primitive for an operator and the version tail after it.  A
// wildcard under an operator is refused, because `>=1.x` names no
// single version to compare against.
fn with_version(piece: Str, skip: Int, op: Str) -> ?Bound
    let tail = str.slice(piece, skip, str.len(piece))
    match parse_tail(tail)
        None    => None
        Some(t) =>
            if t.wildcard
                None
            else if op == "^"
                Some(Caret(base: t.version, written: t.written))
            else if op == "~"
                Some(Tilde(base: t.version, written: t.written))
            else
                Some(Compare(op: op, base: t.version))

// A primitive with no operator.  It is a wildcard, or a version that
// means a caret requirement.
fn bare_bound(piece: Str) -> ?Bound
    match parse_tail(piece)
        None    => None
        Some(t) =>
            if not t.wildcard
                Some(Caret(base: t.version, written: t.written))
            else if t.written == 0
                Some(Any)
            else if t.written == 1
                Some(AnyMinor(major: t.version.major))
            else
                Some(AnyPatch(major: t.version.major, minor: t.version.minor))

// A parsed version tail.  It holds the version with the numbers the
// author did not write left at zero, how many they did write, and
// whether the piece ended in a wildcard.
struct Tail
    version: Version
    written: Int
    wildcard: Bool

// `1`, `1.2`, `1.2.3`, `1.2.3-rc.1`, `x`, `1.x`, `1.2.*`.
fn parse_tail(text: Str) -> ?Tail
    var core = text
    var pre = ""
    match str.index(text, "-")
        None    =>
            pre = ""
        Some(i) =>
            pre = str.slice(text, i + 1, str.len(text))
            core = str.slice(text, 0, i)
    let comps = str.split(core, ".")
    let n = list.len(comps)
    if n == 0 or n > 3
        None
    else if is_wildcard(comps[n - 1])
        // A wildcard counts as one only in the last position, and it
        // takes no prerelease label with it.
        wildcard_tail(comps, n)
    else if not all_of_them_are_digits(comps)
        None
    else
        Some(Tail { version: version_of(comps, n, pre), written: n, wildcard: false })

// The tail for a piece ending in `x`, `X` or `*`.
fn wildcard_tail(comps: [Str], n: Int) -> ?Tail
    let leading = list.take(comps, n - 1)
    if not all_of_them_are_digits(leading)
        None
    else
        Some(Tail { version: version_of(leading, n - 1, ""),
                    written: n - 1, wildcard: true })

// The version those components describe, with the unwritten numbers at
// zero.  That is what a partial requirement means for its lower bound.
fn version_of(comps: [Str], n: Int, pre: Str) -> Version
    Version { major: number_at(comps, 0, n), minor: number_at(comps, 1, n),
              patch: number_at(comps, 2, n), pre: pre, build: "" }

// Component `i`, or zero when the author wrote fewer than `i + 1`.
fn number_at(comps: [Str], i: Int, n: Int) -> Int
    if i < n
        str.to_int(comps[i]) ?? 0
    else
        0

// ── Deciding ─────────────────────────────────────────────────────────

// Whether `v` answers every primitive, the prerelease rule included.
fn satisfies_all(v: Version, bounds: [Bound]) -> Bool
    prerelease_allowed(v, bounds) and every_bound_holds(v, bounds)

// A prerelease is chosen only where the requirement asked for one at
// the same three numbers.  Without this rule `^1.0.0` would pick up
// `1.1.0-alpha`, and a release nobody has finished would arrive in a
// build nobody changed.
fn prerelease_allowed(v: Version, bounds: [Bound]) -> Bool
    if not v.is_prerelease()
        true
    else
        var allowed = false
        for b in bounds
            if opts_into_prereleases(b, v)
                allowed = true
        allowed

// Whether this primitive names a prerelease at `v`'s own three
// numbers, which is the only way a prerelease is ever chosen.
fn opts_into_prereleases(b: Bound, v: Version) -> Bool
    match base_of(b)
        None       => false
        Some(base) => base.is_prerelease() and same_triple(base, v)

// Whether two versions carry the same MAJOR.MINOR.PATCH, whatever
// labels follow it.
fn same_triple(a: Version, b: Version) -> Bool
    a.major == b.major and a.minor == b.minor and a.patch == b.patch

// The version a primitive was written against, where it names one.  A
// wildcard names none, which is why `*` never opts into prereleases.
fn base_of(b: Bound) -> ?Version
    match b
        Any                 => None
        AnyMinor(_major)    => None
        AnyPatch(_maj, _mi) => None
        Caret(base, _w)     => Some(base)
        Tilde(base, _w)     => Some(base)
        Compare(_op, base)  => Some(base)

// Whether every primitive holds, leaving the prerelease rule aside.
fn every_bound_holds(v: Version, bounds: [Bound]) -> Bool
    var holds = true
    for b in bounds
        if not bound_holds(v, b)
            holds = false
    holds

// One primitive, against one version.
fn bound_holds(v: Version, b: Bound) -> Bool
    match b
        Any                    => true
        AnyMinor(major)        => v.major == major
        AnyPatch(major, minor) => v.major == major and v.minor == minor
        Caret(base, _written)  => in_range(v, base, caret_ceiling(base))
        Tilde(base, written)   => in_range(v, base, tilde_ceiling(base, written))
        Compare(op, base)      => compares(v, op, base)

// `base <= v < ceiling`, the shape both caret and tilde reduce to.
fn in_range(v: Version, base: Version, ceiling: Version) -> Bool
    compare(v, base) >= 0 and compare(v, ceiling) < 0

// The first version a caret requirement excludes.  It is the next
// number that is allowed to break a caller.  Below `1.0.0` that is the
// minor and below `0.1.0` it is the patch, which is the rule that
// makes `^0.4.1` refuse `0.5.0`.  Semantic Versioning 2.0.0 item 4
// leaves everything under major version zero free to change, and the
// registry narrows that to the minor number.
fn caret_ceiling(base: Version) -> Version
    if base.major > 0
        Version { major: base.major + 1, minor: 0, patch: 0, pre: "", build: "" }
    else if base.minor > 0
        Version { major: 0, minor: base.minor + 1, patch: 0, pre: "", build: "" }
    else
        Version { major: 0, minor: 0, patch: base.patch + 1, pre: "", build: "" }

// The first version a tilde requirement excludes.  It is the next
// minor where the author wrote one, and the next major where they
// wrote only a major.  So `~1.2` allows `1.2.9` and refuses `1.3.0`,
// while `~1` allows `1.9.0`.
fn tilde_ceiling(base: Version, written: Int) -> Version
    if written >= 2
        Version { major: base.major, minor: base.minor + 1, patch: 0, pre: "", build: "" }
    else
        Version { major: base.major + 1, minor: 0, patch: 0, pre: "", build: "" }

// One comparison operator.
fn compares(v: Version, op: Str, base: Version) -> Bool
    let c = compare(v, base)
    if op == "="
        c == 0
    else if op == ">"
        c > 0
    else if op == ">="
        c >= 0
    else if op == "<"
        c < 0
    else
        c <= 0

// Whether `v` outranks the best candidate so far.
fn better(v: Version, chosen: ?Str, chosen_v: Version) -> Bool
    match chosen
        None    => true
        Some(_) => compare(v, chosen_v) > 0

// ── Small helpers ────────────────────────────────────────────────────

// The version whose every number is zero.  It is the starting point a
// running best candidate is compared against before anything has won.
fn zero_version() -> Version
    Version { major: 0, minor: 0, patch: 0, pre: "", build: "" }

// -1 or 1, from whether the left version is the smaller one.  The
// comparison above reaches this three times.
fn rank(smaller: Bool) -> Int
    if smaller
        -1
    else
        1

// Whether `s` is a non-empty run of decimal digits.  The empty string
// is not a number, which is what makes `1..3` and a trailing dot fail.
// A leading zero passes, so `01` is a number here and is not one to
// Semantic Versioning 2.0.0 item 2.
fn all_digits(s: Str) -> Bool
    let n = str.len(s)
    if n == 0
        false
    else
        var ok = true
        for i in 0..n
            let c = str.byte_str_at(s, i) ?? ""
            if c < "0" or c > "9"
                ok = false
        ok

// Whether every component is a run of digits.
fn all_of_them_are_digits(comps: [Str]) -> Bool
    var ok = true
    for c in comps
        if not all_digits(c)
            ok = false
    ok

// Whether a component is the wildcard a partial requirement ends with.
fn is_wildcard(comp: Str) -> Bool
    comp == "x" or comp == "X" or comp == "*"
