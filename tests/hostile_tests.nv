// hostile_tests.nv — version numbers and requirements as long as a
// header allows.

use std.test
use semver

@test
fn test_numbers_past_64_bits_are_not_versions() [io]
    test.case("a major, minor or patch past 64 bits")
    test.assert(semver.parse("99999999999999999999.0.0") == None)
    test.assert(semver.parse("1.99999999999999999999.0") == None)
    test.assert(semver.parse("1.0.99999999999999999999") == None)
    test.case("a number of 5000 digits")
    test.assert(semver.parse("1." + "9".repeat(5000) + ".0") == None)
    test.case("the largest number an Int holds")
    test.assert(semver.parse("9223372036854775807.0.0") != None)
    test.case("a requirement naming a number past 64 bits is refused, not read as zero")
    test.assert(not semver.requirement_ok(">=99999999999999999999.0.0"))
    test.assert(not semver.requirement_ok("^1.99999999999999999999"))
    test.assert(not semver.satisfies(">=99999999999999999999.0.0", "1.0.0"))
    test.case("an honest version and requirement still read")
    test.assert(semver.parse("1.2.3-alpha.1+build") != None)
    test.assert(semver.satisfies("^1.2", "1.4.0"))

@test
fn test_long_requirements_and_prereleases_are_bounded() [io]
    test.assert(semver.requirement_ok(">=1.0.0, ".repeat(20000) + "<2.0.0"))
    test.assert(semver.parse("1.0.0-" + "a.".repeat(100000) + "a") != None)
    test.assert(semver.best(">=1.0.0", ["1.0.0", "2.0.0"]) == Some("2.0.0"))
